{
  "expo": {
    "name": "Avology",
    "slug": "avology-mobile",
    "scheme": "avology",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/09e6a589-07a0-40e6-9c21-db9e7febe77d"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.avology.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#065F2E"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Avology membutuhkan kamera untuk mengambil foto kebun.",
          "photosPermission": "Avology membutuhkan akses galeri untuk memilih foto kebun.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09e6a589-07a0-40e6-9c21-db9e7febe77d"
      }
    },
    "owner": "iqbalharish"
  }
}
